{
  "name": "@sitecore-marketplace-sdk/client",
  "version": "0.3.6",
  "description": "",
  "type": "module",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm run clean && rollup -c",
    "build:js": "node scripts/build.js",
    "build:types": "tsc --emitDeclarationOnly",
    "build:watch": "node scripts/build.js --watch",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lint": "eslint src --ext .ts",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "generate:docs": "npx typedoc --options ../../typedoc.json --out ../../docs/client src/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=16"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sitecore/sitecore-marketplace-sdk"
  },
  "keywords": [
    "sitecore",
    "marketplace",
    "sdk",
    "client"
  ],
  "dependencies": {
    "@sitecore-marketplace-sdk/core": "0.3.5",
    "tslib": "^2.8.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^20.17.19",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/expect": "^4.1.10",
    "ajv": "^8.17.1",
    "commander": "^15.0.0",
    "esbuild": "^0.28.1",
    "esbuild-node-externals": "^2.0.0",
    "handlebars": "^4.7.7",
    "js-yaml": "^4.3.1",
    "jsdom": "^30.0.1",
    "nanoid": "^3.3.18",
    "prettier": "^3.5.1",
    "rimraf": "^6.0.1",
    "rollup": "^4.34.8",
    "rollup-plugin-copy": "^3.5.0",
    "ts-node": "^10.9.1",
    "tsx": "^4.19.3",
    "typescript": "^5.9.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.8"
  },
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    }
  }
}
